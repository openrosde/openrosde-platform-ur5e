# Panes of the Universal Robots UR5e platform for 'RUN-TMUX-SESSION.bash', in the window 'robot' of the session.
# Each line reads '<layouts> <window> <launch-file> [<arg:=value> ...]', where '<layouts>' is '*' or a comma-separated list such as 'default-gazebo,default-realworld'.
# The panes of the core, such as the FlexBE app and 'rosbridge', come from 'tmux/openrosde.panes'.
# A setup with devices on the robot replaces these panes with its own 'tmux/<setup>.panes', which starts the launch files of its devices too.

default-gazebo     robot  ur5e_bringup_default_gazebo.launch
default-gazebo     robot  ur5e_rviz_default.launch
default-gazebo     robot  ur5e_moveit_default_gazebo.launch
default-gazebo     robot  ur5e_teleop_default_gazebo.launch

default-realworld  robot  ur5e_bringup_default_realworld.launch
default-realworld  robot  ur5e_rviz_default.launch
default-realworld  robot  ur5e_moveit_default_realworld.launch
default-realworld  robot  ur5e_teleop_default_realworld.launch
