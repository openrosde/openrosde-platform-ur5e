<package format="2">
  <name>openrosde_ur5e_launch</name>
  <version>1.0.0</version>
  <description>
    The 'openrosde_ur5e_launch' package provides launch files and the robot description of the Universal Robots UR5e platform.
  </description>
  <maintainer email="lotfi@coarobo.com">Lotfi El Hafi</maintainer>

  <license>Apache-2.0</license>

  <url type="website">https://coarobo.com/</url>
  <url type="repository">https://github.com/openrosde/openrosde-platform-ur5e</url>
  <url type="bugtracker">https://github.com/openrosde/openrosde-platform-ur5e/issues</url>
  <author email="lotfi@coarobo.com">Lotfi El Hafi</author>

  <buildtool_depend>catkin</buildtool_depend>

  <exec_depend>openrosde_launch</exec_depend>
  <exec_depend>openrosde_ur5e_teleop</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz</exec_depend>
  <exec_depend>ur5e_moveit_config</exec_depend>
  <exec_depend>ur_description</exec_depend>
  <exec_depend>ur_gazebo</exec_depend>
  <exec_depend>ur_robot_driver</exec_depend>
  <exec_depend>xacro</exec_depend>

</package>
